{
  "manifest_version": 3,
  "name": "CareerPilot",
  "version": "0.1.0",
  "description": "Capture job context and review CareerPilot actions in Safari.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CareerPilot",
    "default_popup": "popup.html"
  }
}
